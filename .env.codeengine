# IBM Cloud Code Engine Environment Configuration
# This file contains environment variables for Code Engine deployment

# IBM watsonx Configuration (REQUIRED)
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_SPACE_ID=your_space_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Cloud Object Storage Configuration (REQUIRED for document storage)
COS_API_KEY=your_cos_api_key_here
COS_RESOURCE_INSTANCE_ID=your_cos_resource_instance_id_here
COS_ENDPOINT_URL=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_BUCKET_NAME=bankvalidationapp

# Optional: COS HMAC Credentials (for presigned URLs)
COS_ACCESS_KEY_ID=your_hmac_access_key_id
COS_SECRET_ACCESS_KEY=your_hmac_secret_access_key

# Application Configuration
ENVIRONMENT=production
LOG_LEVEL=INFO

# Validation Temporary Directory
VALIDATION_TEMP_DIR=/app/temp/cos_validation

# CORS Configuration (Update with your frontend URL)
ALLOWED_ORIGINS=https://your-frontend-app.codeengine.appdomain.cloud

# Optional: IBM Cloud Monitoring
MONITORING_ENABLED=true

# Security
SECRET_KEY=your_secret_key_here_change_in_production
JWT_SECRET=your_jwt_secret_here_change_in_production